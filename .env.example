# 실제 값은 이 파일이 아니라 .env.local(로컬, 커밋 안 됨)이나
# Vercel 대시보드의 Environment Variables에 넣는다.

# 카카오 REST API 키 (JS 키 아님 — 서버에서만 쓰므로 도메인 제한이 필요 없다)
KAKAO_REST_KEY=

# 구글 Places API (New) 키
GOOGLE_PLACES_KEY=

# 제미나이 API 키 (리뷰 AI 분석용)
GEMINI_API_KEY=

# (선택) 사용할 제미나이 모델. 비워두면 gemini-3.5-flash 사용
GEMINI_MODEL=
